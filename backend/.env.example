APP_NAME="Ostandari API"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://127.0.0.1:8000
APP_LOCALE=fa
APP_TIMEZONE=Asia/Tehran

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=ostandari
DB_USERNAME=root
DB_PASSWORD=
DB_SOCKET=
DB_URL=

CACHE_STORE=file
SESSION_DRIVER=file
QUEUE_CONNECTION=sync
MAIL_MAILER=log
LOG_CHANNEL=single
LOG_LEVEL=info
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:5173,http://127.0.0.1:5173
AUTH_TOKEN_MINUTES=1440
OTP_DRIVER=log
OTP_EXPOSE_LOCAL=true
OTP_TTL_SECONDS=120
OTP_MAX_ATTEMPTS=5
# Optional real SMS: driver=http, HTTPS endpoint and secret in environment only.
SMS_ENDPOINT=
SMS_TOKEN=
SMS_SENDER=
UPLOAD_MAX_KB=20480
REPORT_RESPONSE_DAYS=7
MESSAGE_RESPONSE_DAYS=5
# Carbon weekday numbers: Sunday=0 ... Friday=5 ... Saturday=6.
WORKING_WEEKEND_DAYS=5
WORKING_HOLIDAYS=
ADMIN_EMAIL=admin@ostandari.test
# Set a strong password before initial seeding; setup generates one when blank.
ADMIN_PASSWORD=
