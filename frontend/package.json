{
  "name": "ostandari-frontend",
  "version": "1.1.0",
  "private": true,
  "engines": {
    "node": "^22.22.2 || ^24.15.0 || >=26.0.0"
  },
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1",
    "build": "next build",
    "start": "node scripts/start.mjs",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test tests/*.test.ts",
    "design:css": "node scripts/build-design-css.mjs",
    "design:verify": "node scripts/verify-designs.mjs",
    "prebuild": "npm run design:css",
    "test:integration": "node --import tsx tests/api-live.ts",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "postbuild": "node scripts/prepare-standalone.mjs",
    "audit:links": "node --import tsx scripts/audit-pages.ts"
  },
  "dependencies": {
    "@next/env": "16.4.2",
    "alpinejs": "3.17.4",
    "dompurify": "3.4.17",
    "next": "16.4.2",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "swiper": "11.2.10"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.3.3",
    "@types/alpinejs": "3.17.0",
    "@types/node": "^24.0.0",
    "@types/react": "19.3.0",
    "@types/react-dom": "^19.3.0",
    "jsdom": "30.1.3",
    "postcss": "^8.5.6",
    "postcss-prefix-selector": "^2.1.1",
    "prettier": "^3.6.0",
    "tailwindcss": "4.3.3",
    "tsx": "^4.20.0",
    "typescript": "^7.0.2"
  }
}
